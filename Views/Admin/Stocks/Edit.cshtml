@model StockFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تعديل سهم";
}
<h2 class="mb-4">تعديل السهم</h2>
<div class="card">
    <div class="card-body">
        <form method="post" action="/admin/stocks/edit/@Model.Id">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("~/Views/Admin/Stocks/_StockForm.cshtml", Model)
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">تحديث</button>
                <a href="/admin/stocks" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
