@model IEnumerable<HalalStocks.Models.Video>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة الفيديوهات";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>الفيديوهات</h2>
    <a href="/admin/videos/create" class="btn btn-warning">+ إضافة فيديو</a>
</div>
<table class="table table-hover table-bordered">
    <thead class="table-warning">
        <tr><th>الصورة المصغرة</th><th>العنوان</th><th>الفئة</th><th>التاريخ</th><th>إجراءات</th></tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td><img src="@v.ThumbnailUrl" alt="" style="width:120px;height:68px;object-fit:cover"></td>
                <td>@v.Title</td>
                <td>@v.Category.Name</td>
                <td>@v.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    <a href="/admin/videos/edit/@v.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                            data-bs-target="#confirmDeleteModal" data-action="/admin/videos/delete/@v.Id" data-name="@v.Title">حذف</button>
                </td>
            </tr>
        }
    </tbody>
</table>
@if ((int)ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="confirmDeleteForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">هل أنت متأكد من حذف «<span id="deleteItemName"></span>»؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('confirmDeleteModal').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('confirmDeleteForm').action = btn.getAttribute('data-action');
        document.getElementById('deleteItemName').textContent = btn.getAttribute('data-name');
    });
</script>
}
