@model IEnumerable<HalalStocks.Models.VideoCategory>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "فئات الفيديوهات";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>فئات الفيديوهات</h2>
    <a href="/admin/video-categories/create" class="btn btn-primary">+ إضافة فئة</a>
</div>
<table class="table table-hover table-bordered">
    <thead class="table-primary">
        <tr><th>الاسم</th><th>إجراءات</th></tr>
    </thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Name</td>
                <td>
                    <a href="/admin/video-categories/edit/@cat.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                            data-bs-target="#confirmDeleteModal" data-action="/admin/video-categories/delete/@cat.Id" data-name="@cat.Name">حذف</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="confirmDeleteForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">هل أنت متأكد من حذف «<span id="deleteItemName"></span>»؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تنبيه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">@TempData["DeleteError"]</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('confirmDeleteModal').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('confirmDeleteForm').action = btn.getAttribute('data-action');
        document.getElementById('deleteItemName').textContent = btn.getAttribute('data-name');
    });

    @if (TempData["DeleteError"] != null)
    {
        <text>new bootstrap.Modal(document.getElementById('deleteInfoModal')).show();</text>
    }
</script>
}
