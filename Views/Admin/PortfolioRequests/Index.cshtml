@model List<HalalStocks.Models.PortfolioRequest>
@using HalalStocks.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "طلبات المحافظ";
    var statusFilter = (PortfolioRequestStatus?)ViewBag.StatusFilter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>طلبات المحافظ</h2>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" action="/admin/portfolio-requests" class="d-flex flex-wrap gap-2 align-items-center">
            <label class="mb-0 fw-bold">تصفية بالحالة:</label>
            <select name="status" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">— الكل —</option>
                @foreach (var s in Enum.GetValues<PortfolioRequestStatus>())
                {
                    <option value="@((int)s)" selected="@(statusFilter == s)">@StatusLabel(s)</option>
                }
            </select>
            @if (statusFilter.HasValue)
            {
                <a href="/admin/portfolio-requests" class="btn btn-sm btn-outline-secondary">إلغاء التصفية</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد طلبات.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>المستخدم</th>
                        <th>الهاتف</th>
                        <th>المحافظة</th>
                        <th>رأس المال</th>
                        <th>الحالة</th>
                        <th>تاريخ الطلب</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td>@(r.User?.FullName ?? r.User?.UserName)</td>
                            <td>@r.PhoneNumber</td>
                            <td>@r.Governorate</td>
                            <td>@r.InvestmentCapital.ToString("N0") ج.م</td>
                            <td>@StatusBadge(r.Status)</td>
                            <td>@r.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="/admin/portfolio-requests/@r.Id" class="btn btn-sm btn-primary">تفاصيل</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    string StatusLabel(PortfolioRequestStatus s) => s switch
    {
        PortfolioRequestStatus.New          => "جديد",
        PortfolioRequestStatus.UnderReview  => "قيد المراجعة",
        PortfolioRequestStatus.Contacted    => "تم التواصل",
        PortfolioRequestStatus.ActiveClient => "عميل حالي",
        PortfolioRequestStatus.Rejected     => "مرفوض",
        _ => s.ToString()
    };

    Microsoft.AspNetCore.Html.HtmlString StatusBadge(PortfolioRequestStatus s)
    {
        var (css, label) = s switch
        {
            PortfolioRequestStatus.New          => ("bg-primary",   "جديد"),
            PortfolioRequestStatus.UnderReview  => ("bg-warning text-dark", "قيد المراجعة"),
            PortfolioRequestStatus.Contacted    => ("bg-orange text-dark",  "تم التواصل"),
            PortfolioRequestStatus.ActiveClient => ("bg-success",   "عميل حالي"),
            PortfolioRequestStatus.Rejected     => ("bg-danger",    "مرفوض"),
            _ => ("bg-secondary", s.ToString())
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"badge {css}\">{label}</span>");
    }
}
