@model HalalStocks.ViewModels.Admin.UsersIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>المستخدمون</h2>
    @if (Model.Tab == "admin")
    {
        <a href="/admin/users/create" class="btn btn-secondary">+ إضافة مستخدم</a>
    }
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "admin" ? "active" : "")" href="/admin/users?tab=admin">
            مستخدمو اللوحة
            <span class="badge bg-secondary ms-1">@Model.AdminCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "public" ? "active" : "")" href="/admin/users?tab=public">
            المستخدمون المسجلون
            <span class="badge bg-success ms-1">@Model.PublicCount</span>
        </a>
    </li>
</ul>

<!-- Search box -->
<div class="mb-3" style="max-width:380px">
    <input type="search" id="userSearch" class="form-control" placeholder="بحث بالاسم أو البريد أو الهاتف..." autocomplete="off">
</div>

@if (Model.Tab == "admin")
{
    <!-- Admin / Editor / SuperAdmin users table -->
    <table class="table table-hover table-bordered" id="usersTable">
        <thead class="table-secondary">
            <tr>
                <th>الاسم</th>
                <th>البريد</th>
                <th>الدور</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>
                        <form method="post" action="/admin/users/edit-role/@u.Id" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <select name="role" class="form-select form-select-sm" style="width:auto">
                                @if (u.Role == HalalStocks.Models.UserRole.SuperAdmin) { <option value="SuperAdmin" selected>SuperAdmin</option> } else { <option value="SuperAdmin">SuperAdmin</option> }
                                @if (u.Role == HalalStocks.Models.UserRole.Admin)      { <option value="Admin"      selected>Admin</option>      } else { <option value="Admin">Admin</option>           }
                                @if (u.Role == HalalStocks.Models.UserRole.Editor)     { <option value="Editor"     selected>Editor</option>     } else { <option value="Editor">Editor</option>         }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">تحديث</button>
                        </form>
                    </td>
                    <td>
                        <a href="/admin/users/edit/@u.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                        <form method="post" action="/admin/users/delete/@u.Id" class="d-inline" onsubmit="return confirm('هل أنت متأكد؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <!-- Public registered users table -->
    <table class="table table-hover table-bordered" id="usersTable">
        <thead class="table-secondary">
            <tr>
                <th>الاسم الأول</th>
                <th>الاسم الأخير</th>
                <th>اسم المستخدم</th>
                <th>البريد الإلكتروني</th>
                <th>رقم الهاتف</th>
                <th>تاريخ التسجيل</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.FirstName</td>
                    <td>@u.LastName</td>
                    <td>@u.UserName</td>
                    <td dir="ltr" class="text-end">@u.Email</td>
                    <td dir="ltr" class="text-end">@u.PhoneNumber</td>
                    <td>@u.CreatedAt.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a href="/admin/users/edit/@u.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                        <form method="post" action="/admin/users/delete/@u.Id" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Users.Any())
    {
        <div class="text-center text-muted py-5">
            <p>لا يوجد مستخدمون مسجلون حتى الآن.</p>
        </div>
    }
}

<div id="noResults" class="text-center text-muted py-4" style="display:none">
    لا توجد نتائج مطابقة للبحث.
</div>

<script>
    document.getElementById('userSearch').addEventListener('input', function () {
        var q     = this.value.trim().toLowerCase();
        var rows  = document.querySelectorAll('#usersTable tbody tr');
        var shown = 0;
        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            var match = !q || text.indexOf(q) !== -1;
            row.style.display = match ? '' : 'none';
            if (match) shown++;
        });
        document.getElementById('noResults').style.display = (q && shown === 0) ? '' : 'none';
    });
</script>
