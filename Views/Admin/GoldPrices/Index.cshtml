@model List<HalalStocks.Models.GoldPriceSnapshot>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "أسعار الذهب";
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">أسعار الذهب — عيار 21</h2>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">→ لوحة التحكم</a>
</div>

<!-- Add / Edit form -->
<div class="card shadow-sm mb-4">
    <div class="card-header fw-bold bg-warning text-dark">إضافة أو تحديث سعر</div>
    <div class="card-body">
        <form method="post" action="/admin/gold-prices/save">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label">التاريخ</label>
                    <input type="date" name="date" class="form-control" value="@today" required>
                </div>
                <div class="col-sm-4">
                    <label class="form-label">سعر الجرام (ج.م)</label>
                    <input type="number" name="price" class="form-control" step="0.01" min="0.01"
                           placeholder="مثال: 4250.00" required>
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-warning fw-bold w-100">حفظ السعر</button>
                </div>
            </div>
            <div class="mt-2">
                <small class="text-muted">
                    إذا كان هناك سجل لنفس التاريخ سيتم تحديثه تلقائياً.
                    النصاب = السعر × 85 جرام.
                </small>
            </div>
        </form>
    </div>
</div>

<!-- History table -->
<div class="card shadow-sm">
    <div class="card-header fw-bold">سجل الأسعار</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">لا توجد أسعار مسجّلة بعد.</div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th>التاريخ</th>
                        <th>السعر (ج.م / جرام)</th>
                        <th>النصاب (85 جرام)</th>
                        <th>المصدر</th>
                        <th>آخر تحديث</th>
                        <th>حذف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var isManual = s.Source == "Manual";
                        <tr>
                            <td class="fw-semibold">@s.PriceDate.ToString("yyyy/MM/dd")</td>
                            <td>@s.PriceGram21K.ToString("N2")</td>
                            <td>@((s.PriceGram21K * 85).ToString("N2"))</td>
                            <td>
                                <span class="badge @(isManual ? "bg-success" : "bg-secondary")">
                                    @(isManual ? "يدوي" : "API")
                                </span>
                            </td>
                            <td class="text-muted small">@s.FetchedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <form method="post" action="/admin/gold-prices/delete/@s.Id"
                                      onsubmit="return confirm('حذف سعر يوم @s.PriceDate.ToString("yyyy/MM/dd")؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
