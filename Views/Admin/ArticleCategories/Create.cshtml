@model ArticleCategoryFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إضافة تصنيف مقال";
}
<h2 class="mb-4">إضافة تصنيف مقال جديد</h2>
<div class="card">
    <div class="card-body">
        <form method="post" action="/admin/article-categories/create">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">الاسم *</label>
                <input asp-for="NameAr" class="form-control">
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a href="/admin/article-categories" class="btn btn-outline-secondary">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
