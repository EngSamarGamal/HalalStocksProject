@model HalalStocks.Models.FinancialStatementType
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تعديل نوع القوائم المالية";
}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/admin/financial-statement-types" class="btn btn-outline-secondary btn-sm">← رجوع</a>
    <h2 class="mb-0">تعديل نوع القوائم المالية</h2>
</div>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold">الاسم بالعربية <span class="text-danger">*</span></label>
                <input asp-for="NameAr" class="form-control" required />
                <span asp-validation-for="NameAr" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">الاسم بالإنجليزية</label>
                <input asp-for="NameEn" class="form-control" />
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">ترتيب العرض</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" min="0" />
            </div>
            <button type="submit" class="btn btn-primary px-4">حفظ التغييرات</button>
        </form>
    </div>
</div>
