@model IEnumerable<HalalStocks.Models.FinancialStatementType>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "أنواع القوائم المالية";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">أنواع القوائم المالية</h2>
    <a href="/admin/financial-statement-types/create" class="btn btn-success"><i class="bi bi-plus-lg ms-1"></i>إضافة نوع</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>الترتيب</th>
                    <th>الاسم بالعربية</th>
                    <th>الاسم بالإنجليزية</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">لا توجد أنواع</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@t.DisplayOrder</span></td>
                        <td><strong>@t.NameAr</strong></td>
                        <td class="text-muted">@(t.NameEn ?? "—")</td>
                        <td class="text-end">
                            <a href="/admin/financial-statement-types/edit/@t.Id" class="btn btn-sm btn-outline-primary ms-1">تعديل</a>
                            <form method="post" action="/admin/financial-statement-types/delete/@t.Id" class="d-inline"
                                  onsubmit="return confirm('هل أنت متأكد من حذف هذا النوع؟')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
