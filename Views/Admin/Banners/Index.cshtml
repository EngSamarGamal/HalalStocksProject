@model IEnumerable<HalalStocks.Models.Banner>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "البانرات";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>البانرات</h2>
    <a href="/admin/banners/create" class="btn btn-warning">+ إضافة بانر</a>
</div>
<table class="table table-hover table-bordered align-middle">
    <thead class="table-warning">
        <tr><th>الصورة</th><th>العنوان</th><th>الترتيب</th><th>الحالة</th><th>إجراءات</th></tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td><img src="@b.ImagePath" class="img-thumbnail" style="max-height:60px" alt="@b.TitleAr"></td>
                <td>@b.TitleAr</td>
                <td>@b.DisplayOrder</td>
                <td>
                    @if (b.IsActive)
                    {
                        <span class="badge bg-success">مفعّل</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">غير مفعّل</span>
                    }
                </td>
                <td>
                    <div>
                        <a href="/admin/banners/edit/@b.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal" data-action="/admin/banners/delete/@b.Id" data-name="@b.TitleAr">
                            حذف
                        </button>
                    </div>
                    <form method="post" action="/admin/banners/toggle-active/@b.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning mt-1">@(b.IsActive ? "تعطيل" : "تفعيل")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">لا توجد بانرات بعد.</p>
}

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="confirmDeleteForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">هل أنت متأكد من حذف «<span id="deleteItemName"></span>»؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('confirmDeleteModal').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('confirmDeleteForm').action = btn.getAttribute('data-action');
        document.getElementById('deleteItemName').textContent = btn.getAttribute('data-name');
    });
</script>
}
