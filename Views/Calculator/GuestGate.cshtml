@{
    ViewData["Title"] = "حاسبة تطهير الدخل المحظور";
    ViewData["Description"] = "حاسبة مجانية لتطهير الدخل المحظور من أرباح الأسهم المتوافقة جزئياً مع الشريعة الإسلامية — احسب نسبة ومبلغ التطهير الواجب لكل سهم في محفظتك بسهولة.";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">

        <h1 class="mb-3">حاسبة تطهير الدخل المحظور</h1>
        <p class="text-muted mb-4">
            بعض الأسهم المتوافقة مع الشريعة تحقق جزءاً يسيراً من إيراداتها من أنشطة محظورة
            (كالفوائد الربوية)، ويجب على المستثمر المسلم "تطهير" هذا الجزء من أرباحه بالتصدق به،
            وفق نسبة التطهير المعتمدة لكل سهم. توفر حاسبة كاشف حساب هذه النسبة والمبلغ تلقائياً
            لكل سهم في محفظتك، وإصدار تقرير PDF جاهز لحفظ سجل التطهير الخاص بك.
        </p>

        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <div class="mb-3" style="font-size:2.5rem">🔒</div>
                <h4 class="fw-bold mb-2">سجّل حسابك لاستخدام الحاسبة</h4>
                <p class="text-muted mb-4">
                    استخدام الحاسبة وحفظ سجل عمليات التطهير متاح للأعضاء المسجّلين فقط — والتسجيل مجاني تماماً.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/account/register" class="btn btn-success btn-lg px-5 fw-bold">إنشاء حساب مجاني</a>
                    <a href="/account/login?returnUrl=/calculator" class="btn btn-outline-secondary btn-lg px-4">تسجيل الدخول</a>
                </div>
            </div>
        </div>

    </div>
</div>
