@{ ViewData["Title"] = "حاسبة زكاة المضارب"; var autoEditId = ViewBag.EditId as int?; }

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h2 class="mb-0">حاسبة زكاة الأسهم</h2>
</div>

<!-- Gold Price Banner -->
<div id="goldBanner" class="alert alert-success mb-4" role="alert">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="fw-bold">سعر جرام الذهب عيار 21:</span>
        <span id="goldPriceDisplay" class="fw-bold fs-5">جاري التحميل...</span>
        <span class="badge bg-success me-auto">محدّث تلقائياً</span>
    </div>
    <div id="nisabDisplay" class="text-muted small mt-1"></div>
</div>
<div id="goldError" class="alert alert-warning d-none mb-4">
    تعذر جلب سعر الذهب تلقائياً، يرجى المحاولة لاحقاً
</div>

<!-- Date Gold Price Widget (shown when user picks a date) -->
<div id="datePriceBanner" class="alert alert-info mb-4 d-none" role="alert">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="fw-bold">سعر الذهب عيار 21 في تاريخ البداية:</span>
        <span id="datePriceDisplay" class="fw-bold fs-5">—</span>
        <span class="badge bg-info text-dark me-auto">تاريخ الحساب</span>
    </div>
    <div id="dateNisabDisplay" class="text-muted small mt-1"></div>
</div>
<div id="datePriceNotFound" class="alert alert-warning mb-4 d-none" role="alert">
    <div class="d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
        <span>سعر الذهب غير متوفر في قاعدة البيانات لهذا التاريخ، يرجى مراجعة المشرف لإضافة السعر.</span>
    </div>
</div>

<div class="row g-4">
    <!-- Input Form -->
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div id="formCardHeader" class="card-header bg-success text-white fw-bold">بيانات المحفظة</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">رصيد النقد في المحفظة (ج.م) <span class="text-danger">*</span></label>
                    <input type="number" id="cashBalance" class="form-control" min="0" step="any" placeholder="0.00">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">القيمة السوقية للأسهم (ج.م) <span class="text-danger">*</span></label>
                    <input type="number" id="stocksValue" class="form-control" min="0" step="any" placeholder="0.00">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">التاريخ الميلادي <span class="text-danger">*</span></label>
                    <input type="date" id="entryDate" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">التاريخ الهجري <span class="text-danger">*</span></label>
                    <input type="text" id="hijriDate" class="form-control" placeholder="مثال: 1446/11/01" dir="ltr">
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">حالة الإدخال (اختياري)</label>
                    <select id="entryStatus" class="form-select">
                        <option value="">— اختر —</option>
                        <option value="0">بلوغ النصاب و بدء الحول</option>
                        <option value="1">لم يبلغ النصاب</option>
                        <option value="2">بداية حول جديد</option>
                        <option value="3">انتهاء الحول</option>
                        <option value="4">متابعة سريان الحول</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">ملاحظات (اختياري)</label>
                    <textarea id="notes" class="form-control" rows="2" placeholder="أي ملاحظات إضافية..."></textarea>
                </div>
                <div id="formError" class="alert alert-danger d-none"></div>
                <div class="d-flex gap-2">
                    <button id="saveBtn" class="btn btn-success fw-bold flex-grow-1">حفظ في السجل</button>
                    <button id="cancelEditBtn" class="btn btn-outline-secondary d-none" onclick="cancelEdit()">إلغاء</button>
                </div>
                <div id="saveSuccess" class="alert alert-success mt-3 d-none"></div>
            </div>
        </div>
    </div>

    <!-- Result Card -->
    <div class="col-lg-7 d-flex flex-column gap-3">
        <div class="card shadow-sm flex-grow-1">
            <div class="card-header bg-warning text-dark fw-bold">نتيجة الحساب</div>
            <div class="card-body d-flex flex-column justify-content-center">
                <div id="resultPlaceholder" class="text-center text-muted py-4">
                    أدخل بيانات المحفظة لعرض النتيجة
                </div>
                <div id="resultCard" class="d-none">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="text-muted small">إجمالي المحفظة</div>
                            <div class="fw-bold fs-5" id="resTotal">—</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">النصاب (85 جرام)</div>
                            <div class="fw-bold fs-5" id="resNisab">—</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">الحالة</div>
                        <div id="resStatus" class="fw-bold fs-6"></div>
                    </div>
                    <hr>
                    <div id="zakatDue" class="text-center d-none">
                        <div class="text-muted mb-1">قيمة الزكاة المستحقة</div>
                        <div class="display-6 fw-bold text-success" id="resZakat">—</div>
                        <div class="text-muted small">النسبة: 2.5%</div>
                    </div>
                    <div id="zakatNotDue" class="alert alert-secondary text-center d-none mb-0">
                        المحفظة لم تبلغ النصاب — لا زكاة مستحقة
                    </div>
                </div>
            </div>
        </div>
        <div id="actionBtns" class="d-none">
            <button id="pdfBtn" class="btn btn-outline-primary w-100">تنزيل PDF</button>
        </div>
    </div>
</div>

<!-- History Table -->
<div class="card shadow-sm mt-5">
    <div class="card-header bg-secondary text-white fw-bold d-flex align-items-center justify-content-between">
        <span>سجل حسابات الزكاة</span>
        <button class="btn btn-sm btn-outline-light" onclick="loadHistory()">تحديث</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" id="historyTable">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ</th>
                        <th class="text-end">النقد (ج.م)</th>
                        <th class="text-end">قيمة الأسهم (ج.م)</th>
                        <th class="text-end">الإجمالي (ج.م)</th>
                        <th class="text-end">النصاب (ج.م)</th>
                        <th class="text-center">حالة الزكاة</th>
                        <th class="text-end">مبلغ الزكاة (ج.م)</th>
                        <th>الحالة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="historyBody">
                    <tr><td colspan="9" class="text-center text-muted py-3">جاري التحميل...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
var _goldPrice = 0;
var _nisab     = 0;
var _lastCalc  = null;
var _editId    = null;

var statusLabels = [
    'بلوغ النصاب و بدء الحول',
    'لم يبلغ النصاب',
    'بداية حول جديد',
    'انتهاء الحول',
    'متابعة سريان الحول',
    '—'
];

function fmt(n) {
    return Number(n).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// ── Fetch gold price ──────────────────────────────────────────────────────────
fetch('/zakat/gold-price')
    .then(function(r){ return r.json(); })
    .then(function(data){
        if (!data.success) {
            document.getElementById('goldBanner').classList.add('d-none');
            document.getElementById('goldError').classList.remove('d-none');
            return;
        }
        _goldPrice = data.price;
        _nisab     = data.nisab;
        document.getElementById('goldPriceDisplay').textContent = fmt(data.price) + ' ج.م';
        document.getElementById('nisabDisplay').textContent     = 'النصاب الحالي (85 جرام): ' + fmt(data.nisab) + ' ج.م' + (data.fetchedAt ? ' | آخر تحديث: ' + data.fetchedAt : '');
        recalc();
    })
    .catch(function(){
        document.getElementById('goldBanner').classList.add('d-none');
        document.getElementById('goldError').classList.remove('d-none');
    });

// ── Date gold price lookup ────────────────────────────────────────────────────
document.getElementById('entryDate').addEventListener('change', function() {
    var dateVal = this.value;
    var bannerFound    = document.getElementById('datePriceBanner');
    var bannerNotFound = document.getElementById('datePriceNotFound');

    bannerFound.classList.add('d-none');
    bannerNotFound.classList.add('d-none');

    if (!dateVal) return;

    fetch('/zakat/gold-price-by-date?date=' + dateVal)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.found) {
                document.getElementById('datePriceDisplay').textContent = fmt(data.price) + ' ج.م';
                document.getElementById('dateNisabDisplay').textContent =
                    'النصاب في هذا التاريخ (85 جرام): ' + fmt(data.nisab) + ' ج.م';
                bannerFound.classList.remove('d-none');
            } else {
                bannerNotFound.classList.remove('d-none');
            }
        })
        .catch(function() {
            bannerNotFound.classList.remove('d-none');
        });
});

// ── Live recalc ───────────────────────────────────────────────────────────────
['cashBalance','stocksValue'].forEach(function(id){
    document.getElementById(id).addEventListener('input', recalc);
});

function recalc() {
    if (_goldPrice <= 0) return;
    var cash   = parseFloat(document.getElementById('cashBalance').value) || 0;
    var stocks = parseFloat(document.getElementById('stocksValue').value) || 0;

    if (cash === 0 && stocks === 0) {
        document.getElementById('resultPlaceholder').classList.remove('d-none');
        document.getElementById('resultCard').classList.add('d-none');
        document.getElementById('actionBtns').classList.add('d-none');
        return;
    }

    var total        = cash + stocks;
    var reachedNisab = total >= _nisab;
    var zakatAmount  = reachedNisab ? Math.round(total * 0.025 * 100) / 100 : 0;

    _lastCalc = { cash: cash, stocks: stocks, total: total, reachedNisab: reachedNisab, zakatAmount: zakatAmount };

    document.getElementById('resTotal').textContent = fmt(total) + ' ج.م';
    document.getElementById('resNisab').textContent = fmt(_nisab) + ' ج.م';

    if (reachedNisab) {
        document.getElementById('resStatus').innerHTML = '<span class="text-success">مستحقة للزكاة ✅</span>';
        document.getElementById('zakatDue').classList.remove('d-none');
        document.getElementById('zakatNotDue').classList.add('d-none');
        document.getElementById('resZakat').textContent = fmt(zakatAmount) + ' ج.م';
    } else {
        document.getElementById('resStatus').innerHTML = '<span class="text-danger">غير مستحقة ❌</span>';
        document.getElementById('zakatDue').classList.add('d-none');
        document.getElementById('zakatNotDue').classList.remove('d-none');
    }

    document.getElementById('resultPlaceholder').classList.add('d-none');
    document.getElementById('resultCard').classList.remove('d-none');
    document.getElementById('actionBtns').classList.remove('d-none');
    document.getElementById('saveSuccess').classList.add('d-none');
}

// ── Build save/update payload ─────────────────────────────────────────────────
function buildPayload(goldPrice) {
    var statusVal = document.getElementById('entryStatus').value;
    return {
        cashBalance:       _lastCalc.cash,
        stocksMarketValue: _lastCalc.stocks,
        goldGramPrice21K:  goldPrice,
        status:            statusVal !== '' ? parseInt(statusVal) : null,
        entryDate:         document.getElementById('entryDate').value,
        hijriDate:         document.getElementById('hijriDate').value || null,
        notes:             document.getElementById('notes').value     || null
    };
}

// ── Save / Update ─────────────────────────────────────────────────────────────
document.getElementById('saveBtn').addEventListener('click', function(){
    var errEl = document.getElementById('formError');
    errEl.classList.add('d-none');

    if (!_lastCalc) return;

    var entryDate = document.getElementById('entryDate').value;
    if (!entryDate) {
        errEl.textContent = 'يرجى إدخال التاريخ الميلادي.';
        errEl.classList.remove('d-none');
        return;
    }

    var hijriDate = document.getElementById('hijriDate').value.trim();
    if (!hijriDate) {
        errEl.textContent = 'يرجى إدخال التاريخ الهجري.';
        errEl.classList.remove('d-none');
        return;
    }

    var gp      = _editId ? parseFloat(document.getElementById('editGoldPrice').value) || _goldPrice : _goldPrice;
    var payload = buildPayload(gp);
    var url     = _editId ? '/zakat/' + _editId : '/zakat/save';
    var method  = _editId ? 'PUT' : 'POST';

    fetch(url, {
        method:  method,
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload)
    })
    .then(function(r){
        if (!r.ok) throw new Error();
        var msgEl = document.getElementById('saveSuccess');
        msgEl.textContent = _editId ? 'تم تحديث السجل بنجاح ✓' : 'تم حفظ السجل بنجاح ✓';
        msgEl.classList.remove('d-none');
        cancelEdit();
        loadHistory();
    })
    .catch(function(){
        errEl.textContent = 'حدث خطأ أثناء الحفظ، يرجى المحاولة مرة أخرى.';
        errEl.classList.remove('d-none');
    });
});

// ── Edit mode ─────────────────────────────────────────────────────────────────
function startEdit(r) {
    _editId    = r.id;
    _goldPrice = r.goldGramPrice;
    _nisab     = r.nisabValue;

    document.getElementById('cashBalance').value  = r.cashBalance;
    document.getElementById('stocksValue').value  = r.stocksMarketValue;
    document.getElementById('entryDate').value    = r.entryDate;
    document.getElementById('hijriDate').value    = r.hijriDate  || '';
    document.getElementById('entryStatus').value  = r.status;
    document.getElementById('notes').value        = r.notes      || '';

    // store original gold price for the edit payload
    var hidden = document.getElementById('editGoldPrice');
    if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.id   = 'editGoldPrice';
        document.body.appendChild(hidden);
    }
    hidden.value = r.goldGramPrice;

    document.getElementById('formCardHeader').textContent = 'تعديل السجل';
    document.getElementById('formCardHeader').className  = 'card-header bg-warning text-dark fw-bold';
    document.getElementById('saveBtn').textContent       = 'تحديث السجل';
    document.getElementById('cancelEditBtn').classList.remove('d-none');
    document.getElementById('saveSuccess').classList.add('d-none');

    recalc();
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function cancelEdit() {
    _editId    = null;
    _goldPrice = parseFloat(document.getElementById('goldPriceDisplay').textContent) || 0;

    document.getElementById('cashBalance').value  = '';
    document.getElementById('stocksValue').value  = '';
    document.getElementById('entryDate').value    = '';
    document.getElementById('hijriDate').value    = '';
    document.getElementById('entryStatus').value  = '';
    document.getElementById('notes').value        = '';

    document.getElementById('formCardHeader').textContent = 'بيانات المحفظة';
    document.getElementById('formCardHeader').className  = 'card-header bg-success text-white fw-bold';
    document.getElementById('saveBtn').textContent       = 'حفظ في السجل';
    document.getElementById('cancelEditBtn').classList.add('d-none');
    document.getElementById('formError').classList.add('d-none');
    document.getElementById('datePriceBanner').classList.add('d-none');
    document.getElementById('datePriceNotFound').classList.add('d-none');

    document.getElementById('resultPlaceholder').classList.remove('d-none');
    document.getElementById('resultCard').classList.add('d-none');
    document.getElementById('actionBtns').classList.add('d-none');

    // restore live gold price display
    fetch('/zakat/gold-price').then(function(r){ return r.json(); }).then(function(data){
        if (data.success) {
            _goldPrice = data.price;
            _nisab     = data.nisab;
        }
    });
}

// ── Delete ────────────────────────────────────────────────────────────────────
function deleteRecord(id) {
    if (!confirm('حذف هذا السجل نهائياً؟')) return;
    fetch('/zakat/' + id, { method: 'DELETE' })
        .then(function(r){ if (r.ok) loadHistory(); });
}

// ── Load history + auto-edit support ─────────────────────────────────────────
var _autoEditId = @(autoEditId.HasValue ? autoEditId.Value.ToString() : "null");

function loadHistory() {
    fetch('/zakat/history')
        .then(function(r){ return r.json(); })
        .then(function(data){
            var tbody = document.getElementById('historyBody');
            if (!data.length) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-3">لا توجد سجلات محفوظة</td></tr>';
                return;
            }

            window._zakatHistory = data;

            tbody.innerHTML = data.map(function(r){
                var reached = r.reachedNisab;
                var badge   = reached
                    ? '<span class="badge bg-success">مستحقة ✅</span>'
                    : '<span class="badge bg-danger">غير مستحقة ❌</span>';
                var zakat   = reached ? fmt(r.zakatAmount) : '—';
                var date    = r.hijriDate
                    ? r.entryDate + '<br><small class="text-muted">' + r.hijriDate + '</small>'
                    : r.entryDate;
                return '<tr>' +
                    '<td>' + date + '</td>' +
                    '<td class="text-end" dir="ltr">' + fmt(r.cashBalance) + '</td>' +
                    '<td class="text-end" dir="ltr">' + fmt(r.stocksMarketValue) + '</td>' +
                    '<td class="text-end fw-bold" dir="ltr">' + fmt(r.totalPortfolio) + '</td>' +
                    '<td class="text-end" dir="ltr">' + fmt(r.nisabValue) + '</td>' +
                    '<td class="text-center">' + badge + '</td>' +
                    '<td class="text-end fw-bold text-success" dir="ltr">' + zakat + '</td>' +
                    '<td><small>' + (statusLabels[r.status] || '') + '</small></td>' +
                    '<td class="text-nowrap">' +
                        '<a href="/zakat/' + r.id + '" class="btn btn-sm btn-outline-secondary ms-1">تفاصيل</a>' +
                        '<button class="btn btn-sm btn-outline-warning ms-1" onclick="startEdit(window._zakatHistory.find(function(x){return x.id===' + r.id + '}))">تعديل</button>' +
                        '<button class="btn btn-sm btn-outline-danger" onclick="deleteRecord(' + r.id + ')">حذف</button>' +
                    '</td>' +
                '</tr>';
            }).join('');

            // if arrived from detail page with ?edit=id, trigger edit mode
            if (_autoEditId) {
                var rec = data.find(function(x){ return x.id === _autoEditId; });
                if (rec) { startEdit(rec); _autoEditId = null; }
            }
        });
}

loadHistory();

// ── PDF ───────────────────────────────────────────────────────────────────────
document.getElementById('pdfBtn').addEventListener('click', function(){
    if (!_lastCalc) return;

    var entryDate = document.getElementById('entryDate').value || new Date().toISOString().slice(0,10);
    var hijri     = document.getElementById('hijriDate').value;
    var notes     = document.getElementById('notes').value;
    var statusTxt = statusLabels[parseInt(document.getElementById('entryStatus').value)];
    var goldUsed  = _editId ? (parseFloat(document.getElementById('editGoldPrice').value) || _goldPrice) : _goldPrice;
    var nisabUsed = Math.round(goldUsed * 85 * 100) / 100;

    var zakatLine = _lastCalc.reachedNisab
        ? '<div class="zakat-val">' + fmt(_lastCalc.zakatAmount) + ' ج.م</div><div class="rate">النسبة: 2.5%</div>'
        : '<div class="no-zakat">المحفظة لم تبلغ النصاب — لا زكاة مستحقة</div>';

    var win = window.open('', '_blank');
    if (!win) { alert('يرجى السماح بالنوافذ المنبثقة لهذا الموقع ثم حاول مرة أخرى.'); return; }

    var origin   = window.location.origin;
    var pageRule = String.fromCharCode(64) + 'page{size:A4;margin:10mm}';

    var doc = win.document;
    doc.open();
    doc.write('<!DOCTYPE html>');
    doc.write('<html dir="rtl" lang="ar">');
    doc.write('<head><meta charset="UTF-8"><title>تقرير زكاة الأسهم</title>');
    doc.write('<style>');
    doc.write('html,body{margin:0;padding:0}');
    doc.write('body{font-family:Arial,Tahoma,sans-serif;direction:rtl;padding:10mm;font-size:10pt;color:#000}');
    doc.write('.hdr{text-align:center;margin-bottom:10pt}');
    doc.write('.logo{width:44pt;height:44pt;border-radius:50%;border:1.5pt solid #198754;object-fit:cover}');
    doc.write('.site{font-size:14pt;font-weight:bold;color:#198754;margin:3pt 0 1pt}');
    doc.write('.ttl{font-size:11pt;font-weight:bold}');
    doc.write('.dt{font-size:8pt;color:#666;margin-top:2pt}');
    doc.write('.summary{border:1pt solid #ddd;border-radius:4pt;padding:12pt 16pt;margin:12pt 0}');
    doc.write('.summary table{width:100%;border-collapse:collapse}');
    doc.write('.summary td{padding:5pt 8pt;font-size:10pt}');
    doc.write('.summary td:last-child{text-align:left;font-weight:bold;direction:ltr}');
    doc.write('.zakat-box{text-align:center;margin:14pt 0;padding:12pt;background:#f0faf4;border-radius:4pt}');
    doc.write('.zakat-label{font-size:10pt;color:#555;margin-bottom:4pt}');
    doc.write('.zakat-val{font-size:22pt;font-weight:bold;color:#198754}');
    doc.write('.rate{font-size:9pt;color:#888;margin-top:3pt}');
    doc.write('.no-zakat{font-size:12pt;color:#888;padding:10pt}');
    doc.write('.footer{font-size:8pt;color:#777;border-top:0.5pt solid #ddd;padding-top:6pt;margin-top:14pt;text-align:center}');
    doc.write(pageRule);
    doc.write('</style></head><body>');
    doc.write('<div class="hdr">');
    doc.write('<img src="' + origin + '/logo3.jpeg" class="logo" alt="كاشف">');
    doc.write('<div class="site">كاشف</div>');
    doc.write('<div class="ttl">تقرير زكاة الأسهم</div>');
    doc.write('<div class="dt">التاريخ: ' + entryDate + (hijri ? ' | الهجري: ' + hijri : '') + '</div>');
    doc.write('</div>');
    doc.write('<div class="summary"><table>');
    doc.write('<tr><td>رصيد النقد</td><td>' + fmt(_lastCalc.cash) + ' ج.م</td></tr>');
    doc.write('<tr><td>القيمة السوقية للأسهم</td><td>' + fmt(_lastCalc.stocks) + ' ج.م</td></tr>');
    doc.write('<tr><td>إجمالي المحفظة</td><td>' + fmt(_lastCalc.total) + ' ج.م</td></tr>');
    doc.write('<tr><td>سعر جرام الذهب عيار 21</td><td>' + fmt(goldUsed) + ' ج.م</td></tr>');
    doc.write('<tr><td>النصاب (85 جرام)</td><td>' + fmt(nisabUsed) + ' ج.م</td></tr>');
    doc.write('<tr><td>الحالة</td><td>' + statusTxt + '</td></tr>');
    if (notes) doc.write('<tr><td>ملاحظات</td><td>' + notes + '</td></tr>');
    doc.write('</table></div>');
    doc.write('<div class="zakat-box">');
    doc.write('<div class="zakat-label">قيمة الزكاة المستحقة</div>');
    doc.write(zakatLine);
    doc.write('</div>');
    doc.write('<div class="footer">تذكير: الزكاة ركن من أركان الإسلام، أدِّها في وقتها</div>');
    doc.close();
    win.focus();
    setTimeout(function(){ win.print(); }, 400);
});
</script>
