@{
    ViewData["Title"] = "حاسبة زكاة المضارب";
    ViewData["Description"] = "حاسبة مجانية لزكاة أسهم المضارب المستثمر في السوق المصري — احسب النصاب وزكاة رصيدك النقدي وقيمة أسهمك السوقية وفق سعر الذهب المحدّث تلقائياً.";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">

        <h1 class="mb-3">حاسبة زكاة الأسهم</h1>
        <p class="text-muted mb-4">
            يُحسب نصاب الزكاة على أساس قيمة 85 جراماً من الذهب عيار 21، وتُحسب زكاة المضارب في الأسهم
            (2.5٪) على مجموع رصيده النقدي وقيمة أسهمه السوقية إذا بلغ هذا المجموع النصاب. توفر حاسبة
            كاشف سعر الذهب المحدّث تلقائياً، وتحفظ لك سجل حسابات الزكاة عبر السنوات للرجوع إليه.
        </p>

        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <div class="mb-3" style="font-size:2.5rem">🔒</div>
                <h4 class="fw-bold mb-2">سجّل حسابك لاستخدام الحاسبة</h4>
                <p class="text-muted mb-4">
                    استخدام الحاسبة وحفظ سجل حسابات الزكاة متاح للأعضاء المسجّلين فقط — والتسجيل مجاني تماماً.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/account/register" class="btn btn-success btn-lg px-5 fw-bold">إنشاء حساب مجاني</a>
                    <a href="/account/login?returnUrl=/zakat" class="btn btn-outline-secondary btn-lg px-4">تسجيل الدخول</a>
                </div>
            </div>
        </div>

    </div>
</div>
