<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة تحكم كاشف</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .sidebar { min-height: 100vh; background: #1a3c34; }
        .sidebar .nav-link { color: rgba(255,255,255,0.8); }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.1); border-radius: 8px; }
        .sidebar-brand { color: #fff; font-size: 1.2rem; font-weight: 700; }
        .form-control.input-validation-error, .form-select.input-validation-error { border-color: #dc3545; }
        .field-validation-error { color: #dc3545; font-size: 0.875em; }
    </style>
</head>
<body class="bg-light">
<div class="container-fluid">
    <div class="row">
        <nav class="col-md-3 col-lg-2 d-md-block sidebar py-3 px-3">
            <div class="sidebar-brand mb-4 d-block text-center">🕌 كاشف</div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item"><a class="nav-link" href="/admin"><i class="bi bi-speedometer2 ms-2"></i>لوحة التحكم</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/stocks"><i class="bi bi-bar-chart-line ms-2"></i>الأسهم</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/categories"><i class="bi bi-tags ms-2"></i>الفئات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/banners"><i class="bi bi-images ms-2"></i>البانرات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/articles"><i class="bi bi-newspaper ms-2"></i>المقالات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/article-categories"><i class="bi bi-bookmarks ms-2"></i>تصنيفات المقالات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/analytics"><i class="bi bi-lightbulb ms-2"></i>التحليلات والآراء</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/fatawa"><i class="bi bi-chat-square-text ms-2"></i>فتاوى المال</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/videos"><i class="bi bi-camera-video ms-2"></i>الفيديوهات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/video-categories"><i class="bi bi-collection-play ms-2"></i>فئات الفيديوهات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/indices"><i class="bi bi-graph-up ms-2"></i>المؤشرات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/users"><i class="bi bi-people ms-2"></i>المستخدمون</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/gold-prices"><i class="bi bi-coin ms-2"></i>أسعار الذهب</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/financial-statement-types"><i class="bi bi-file-earmark-text ms-2"></i>أنواع القوائم المالية</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/portfolio-sections"><i class="bi bi-layers ms-2"></i>أقسام المحفظة</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/portfolio-requests"><i class="bi bi-briefcase ms-2"></i>طلبات المحافظ</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/recommendation-requests"><i class="bi bi-star ms-2"></i>التوصيات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/wallet-management-requests"><i class="bi bi-person-check ms-2"></i>طلبات إدارة المحافظ</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/instructions"><i class="bi bi-info-circle ms-2"></i>الإرشادات</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/settings"><i class="bi bi-gear ms-2"></i>الإعدادات</a></li>
                <li class="nav-item mt-3">
                    <form method="post" action="/admin/logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link btn btn-link text-danger w-100 text-start"><i class="bi bi-box-arrow-left ms-2"></i>تسجيل الخروج</button>
                    </form>
                </li>
            </ul>
        </nav>
        <main class="col-md-9 col-lg-10 px-4 py-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
