@{
    Layout = "_Layout";
    var code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "الصفحة غير موجودة" : "خطأ في الخادم";
    ViewData["NoIndex"] = true;
}
<div class="text-center py-5">
    <h1 class="display-1 text-muted">@code</h1>
    <h2>@(code == 404 ? "الصفحة غير موجودة" : "حدث خطأ في الخادم")</h2>
    <p class="text-muted">@(code == 404 ? "الصفحة التي تبحث عنها غير موجودة أو تم نقلها." : "نعتذر، حدث خطأ غير متوقع. يرجى المحاولة لاحقاً.")</p>
    <a href="/" class="btn btn-success mt-3">العودة للرئيسية</a>
</div>
