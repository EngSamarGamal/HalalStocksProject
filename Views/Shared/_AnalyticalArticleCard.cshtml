@model AnalyticalArticleCardViewModel

<div class="card h-100 shadow-sm analytical-card">
    @if (!string.IsNullOrEmpty(Model.FeaturedImagePath))
    {
        <img src="@Model.FeaturedImagePath" class="card-img-top" alt="@Model.TitleAr" style="height:170px;object-fit:cover">
    }
    else
    {
        <div class="bg-light d-flex align-items-center justify-content-center" style="height:170px">
            <i class="bi bi-graph-up-arrow text-secondary" style="font-size:3rem"></i>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a href="/analysts/@Model.AuthorId" class="text-decoration-none">
                @if (!string.IsNullOrEmpty(Model.AuthorPhotoPath))
                {
                    <img src="@Model.AuthorPhotoPath" class="rounded-circle" style="width:32px;height:32px;object-fit:cover" alt="@Model.AuthorName">
                }
                else
                {
                    <i class="bi bi-person-circle text-secondary" style="font-size:2rem"></i>
                }
            </a>
            <a href="/analysts/@Model.AuthorId" class="text-decoration-none text-dark small fw-semibold analytical-card-author">@Model.AuthorName</a>
        </div>

        <h6 class="card-title analytical-card-title">
            <a href="/articles/@Model.ArticleId" class="text-decoration-none text-dark">@TextHelper.Truncate(Model.TitleAr, 120)</a>
        </h6>

        <div class="mt-auto d-flex justify-content-between align-items-center">
            <small class="text-muted">@Model.PublishedAt?.ToString("dd/MM/yyyy")</small>
            <small class="text-muted"><i class="bi bi-heart-fill text-danger"></i> @Model.LikeCount</small>
        </div>
    </div>
</div>
