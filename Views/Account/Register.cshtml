@model HalalStocks.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب";
    ViewData["NoIndex"] = true;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold">إنشاء حساب جديد</h4>
            </div>
            <div class="card-body p-4">

                <form asp-action="Register" asp-controller="Account" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger py-2 mb-3">
                            @foreach (var entry in ViewData.ModelState.Values)
                                @foreach (var err in entry.Errors)
                                {
                                    <div>@err.ErrorMessage</div>
                                }
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="محمد">
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="أحمد">
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" placeholder="username123" autocomplete="username">
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="example@email.com" dir="ltr" autocomplete="email">
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="01012345678" dir="ltr">
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password">
                        <div class="form-text">8 أحرف على الأقل، حرف كبير وحرف صغير ورقم</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg fw-bold">إنشاء الحساب</button>
                    </div>

                    <div class="mt-3 text-center">
                        <span class="text-muted">لديك حساب بالفعل؟</span>
                        <a href="/account/login" class="text-success fw-semibold">سجل الدخول</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
