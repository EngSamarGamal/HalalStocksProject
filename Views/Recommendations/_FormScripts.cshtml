@model HalalStocks.ViewModels.StockRecommendationFormViewModel
@{
    var selectedStockId = Model.StockId;
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.rtl.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/validation-messages-ar.js" asp-append-version="true"></script>

<script>
    var stocksData = [];
    var selectedStockId = @selectedStockId;

    $(function () {
        $('#stockSelect').select2({
            theme: 'bootstrap-5',
            placeholder: '-- اختر السهم --',
            allowClear: true,
            language: {
                noResults:  function () { return 'لا توجد نتائج'; },
                searching:  function () { return 'جاري البحث...'; }
            }
        });

        $('#stockSelect').on('change', function () {
            var stockId = parseInt(this.value, 10);
            if (!stockId) return;
            for (var i = 0; i < stocksData.length; i++) {
                if (stocksData[i].id === stockId) {
                    var purityInput = document.getElementById('PurityGradeLabel');
                    if (!purityInput.value.trim()) {
                        purityInput.value = stocksData[i].purityGradeLabel || '';
                    }
                    break;
                }
            }
        });
    });

    fetch('/api/stocks/active')
        .then(function (r) { return r.json(); })
        .then(function (data) {
            stocksData = data;
            var sel = document.getElementById('stockSelect');
            data.forEach(function (s) {
                var opt = new Option(s.ticker + ' — ' + s.nameAr, s.id, false, s.id === selectedStockId);
                sel.appendChild(opt);
            });
        });
</script>
