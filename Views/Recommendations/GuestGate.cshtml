@{
    ViewData["Title"] = "التوصيات";
    ViewData["Description"] = "خدمة التوصيات والتحليلات الفنية من كاشف — توصيات على أسهم البورصة المصرية مع أسعار الدخول والأهداف ووقف الخسارة، متاحة لعملاء شركات السمسرة المتعاقدة.";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">

        <h1 class="mb-3">خدمات التوصيات والتحليلات الفنية</h1>
        <p class="text-muted mb-4">
            توصيات على أسهم البورصة المصرية مع سعر الدخول والأهداف ووقف الخسارة ودرجة النقاء الشرعي لكل سهم،
            إلى جانب المستشار الآلي لحساب حجم المركز والمخاطرة، ومتابعة محفظتك الفعلية بأسعار السوق.
            الخدمة متاحة لعملاء شركات السمسرة المتعاقدة مع كاشف.
        </p>

        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <div class="mb-3" style="font-size:2.5rem">🔒</div>
                <h4 class="fw-bold mb-2">سجّل حسابك للاطلاع على التوصيات</h4>
                <p class="text-muted mb-4">
                    الاطلاع على التوصيات وإرسال طلب الانضمام للخدمة متاح للأعضاء المسجّلين فقط — والتسجيل مجاني تماماً.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/account/register" class="btn btn-success btn-lg px-5 fw-bold">إنشاء حساب مجاني</a>
                    <a href="/account/login?returnUrl=/recommendations" class="btn btn-outline-secondary btn-lg px-4">تسجيل الدخول</a>
                </div>
            </div>
        </div>

    </div>
</div>
