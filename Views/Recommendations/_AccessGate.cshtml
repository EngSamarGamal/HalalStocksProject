@model HalalStocks.ViewModels.RecommendationsPageState
@using HalalStocks.ViewModels

@if (Model == RecommendationsPageState.Gate)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <div class="mb-3" style="font-size:3rem;">📊</div>
            <h4 class="mb-3">خدمة التوصيات</h4>
            <p class="text-muted mb-4 mx-auto" style="max-width:520px;">
                تنبيه هام:
                طلب الخدمة يستلزم أن يقوم المستثمر بتسجيل حساب تداول مع إحدى شركات السمسرة المرخصة لدينا في السوق المصري قبل إرسال طلب الانضمام.
            </p>
            <form method="post" action="/recommendations/join-request">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-lg px-4">ارسال طلب انضمام</button>
            </form>
            <div class="mt-3 text-center">
                <span class="text-muted">ليس لديك حساب تداول؟</span>
                <a href="/portfolio-request" class="text-success fw-semibold">افتح حساب</a>
            </div>
        </div>
    </div>
}
else if (Model == RecommendationsPageState.Pending)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <div class="mb-3" style="font-size:3rem;">⏳</div>
            <h4 class="mb-3">طلبك قيد المراجعة</h4>
            <p class="text-muted mb-0 mx-auto" style="max-width:520px;">
                هذه الخدمة خاصه لعملاء عكاظ للسمسره والاستثمارات الماليه يمكنك التواصل مع الادارة لفتح حساب تداول مجانا.
            </p>
        </div>
        <div class="mt-3 mb-2 text-center">
            <span class="text-muted">ليس لديك حساب تداول؟</span>
            <a href="/portfolio-request" class="text-success fw-semibold">افتح حساب</a>
        </div>
    </div>
}
