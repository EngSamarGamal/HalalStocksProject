@model HalalStocks.ViewModels.StockRecommendationFormViewModel
@using HalalStocks.Models
@{
    ViewData["Title"] = "إضافة توصية خاصة";
    ViewData["NoIndex"] = true;
    Model.IsPrivate = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>إضافة توصية خاصة</h2>
    <a href="/recommendations" class="btn btn-outline-secondary">← العودة</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" action="/recommendations/my/create">
            @Html.AntiForgeryToken()
            <partial name="_FormFields" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-success">حفظ التوصية</button>
                <a href="/recommendations" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_FormScripts" model="Model" />
}
