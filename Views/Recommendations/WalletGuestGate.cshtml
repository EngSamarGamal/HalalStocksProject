@{
    ViewData["Title"] = "المستشار الآلي";
    ViewData["Description"] = "المستشار الآلي من كاشف — أداة لبناء محفظة من التوصيات وحساب حجم المركز ونسبة المخاطرة والربح المتوقع لكل سهم قبل الشراء.";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">

        <h1 class="mb-3">المستشار الآلي</h1>
        <p class="text-muted mb-4">
            أداة تساعدك على بناء محفظة من التوصيات المتاحة: تحدّد رصيدك النقدي ونسبة المخاطرة المقبولة،
            فيحسب لك المستشار حجم المركز لكل سهم، والوزن النسبي داخل المحفظة، والربح المتوقع والخسارة
            المحتملة عند وقف الخسارة — قبل تنفيذ الشراء.
        </p>

        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <div class="mb-3" style="font-size:2.5rem">🔒</div>
                <h4 class="fw-bold mb-2">سجّل حسابك لاستخدام المستشار الآلي</h4>
                <p class="text-muted mb-4">
                    استخدام المستشار الآلي وحفظ محفظتك متاح للأعضاء المسجّلين فقط — والتسجيل مجاني تماماً.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/account/register" class="btn btn-success btn-lg px-5 fw-bold">إنشاء حساب مجاني</a>
                    <a href="/account/login?returnUrl=/recommendations/wallet" class="btn btn-outline-secondary btn-lg px-4">تسجيل الدخول</a>
                </div>
            </div>
        </div>

    </div>
</div>
