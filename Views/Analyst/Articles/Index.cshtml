@using HalalStocks.Helpers
@model AnalystArticleListViewModel
@{
    ViewData["Title"] = "مقالاتي";
    ViewData["NoIndex"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">مقالاتي</h2>
    <a href="/analyst/articles/create" class="btn btn-success">+ مقال جديد</a>
</div>

<partial name="~/Views/Analyst/_AnalystNav.cshtml" model="@("articles")" />

@if (Model.Articles.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr><th>العنوان</th><th>الحالة</th><th>تاريخ الإنشاء</th><th>إجراءات</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Articles)
                {
                    var (label, badgeClass) = ArticleApprovalStatusHelper.Badge(a.ApprovalStatus);
                    <tr>
                        <td>@a.TitleAr</td>
                        <td>
                            <span class="badge @badgeClass">@label</span>
                            @if (a.ApprovalStatus == HalalStocks.Models.ArticleApprovalStatus.Hidden && !string.IsNullOrEmpty(a.HideReason))
                            {
                                <div class="text-danger small mt-1">@a.HideReason</div>
                            }
                        </td>
                        <td>@a.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="/analyst/articles/edit/@a.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#confirmDeleteModal" data-action="/analyst/articles/delete/@a.Id" data-name="@a.TitleAr">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <p>لم تقم بإضافة أي مقالات بعد.</p>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="confirmDeleteForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">هل أنت متأكد من حذف «<span id="deleteItemName"></span>»؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('confirmDeleteModal').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('confirmDeleteForm').action = btn.getAttribute('data-action');
        document.getElementById('deleteItemName').textContent = btn.getAttribute('data-name');
    });
</script>
}
