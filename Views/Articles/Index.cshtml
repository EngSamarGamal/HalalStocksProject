@model ArticleListViewModel
@{
    ViewData["Title"] = "المقالات";
}
<h2 class="mb-4">المقالات</h2>

<form method="get" action="/articles" class="row g-2 mb-4">
    <div class="col-12 col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="ابحث بالعنوان أو المحتوى..." autocomplete="off">
    </div>
    <div class="col-8 col-md-4">
        <select name="category" asp-items="Model.Categories" class="form-select">
            <option value="">كل التصنيفات</option>
        </select>
    </div>
    <div class="col-4 col-md-2">
        <button type="submit" class="btn btn-success w-100">بحث</button>
    </div>
</form>

@if (Model.Articles.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var article in Model.Articles)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (article.FeaturedImagePath != null)
                    {
                        <img src="@article.FeaturedImagePath" class="card-img-top" alt="" style="height:200px;object-fit:cover">
                    }
                    <div class="card-body">
                        <h6 class="card-title article-card-title"><a href="/articles/@article.Id" class="text-decoration-none text-dark">@TextHelper.Truncate(article.TitleAr, 100)</a></h6>
                        <small class="text-muted d-block">@article.ArticleCategory.NameAr</small>
                        <small class="text-muted">@article.PublishedAt?.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <p>لا توجد مقالات مطابقة.</p>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&search=@Model.Search&category=@Model.CategoryId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
