        "الأردن", "لبنان", "سوريا", "العراق", "فلسطين", "اليمن", "ليبيا", "تونس",
        "الجزائر", "المغرب", "موريتانيا", "السودان", "الصومال", "جيبوتي", "جزر القمر",
        "المملكة المتحدة", "ألمانيا", "فرنسا", "إيطاليا", "إسبانيا", "هولندا", "بلجيكا",
        "السويد", "النرويج", "الدنمارك", "سويسرا", "النمسا", "البرتغال", "اليونان",
        "الولايات المتحدة الأمريكية", "كندا", "أستراليا", "نيوزيلندا",
        "تركيا", "ماليزيا", "إندونيسيا", "باكستان", "بنغلاديش", "الهند",
        "الصين", "اليابان", "كوريا الجنوبية", "روسيا", "أوكرانيا", "بولندا",
