@{
    ViewData["Title"] = "المحفظة الفعلية";
    ViewData["Description"] = "المحفظة الفعلية من كاشف — تابع أسهمك الحقيقية بأسعار السوق واحسب أرباحك وخسائرها ووزن كل سهم داخل محفظتك.";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">

        <h1 class="mb-3">المحفظة الفعلية</h1>
        <p class="text-muted mb-4">
            سجّل الأسهم التي تمتلكها فعلياً بسعر وتاريخ الشراء، فتتابع المحفظة قيمتها بأسعار السوق المحدَّثة
            وتعرض لك الربح أو الخسارة لكل سهم وللمحفظة ككل، مع وزن كل سهم ورأس المال المستثمر والمتاح.
        </p>

        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <div class="mb-3" style="font-size:2.5rem">🔒</div>
                <h4 class="fw-bold mb-2">سجّل حسابك لمتابعة محفظتك</h4>
                <p class="text-muted mb-4">
                    إنشاء المحفظة الفعلية ومتابعة أرباحها متاح للأعضاء المسجّلين فقط — والتسجيل مجاني تماماً.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/account/register" class="btn btn-success btn-lg px-5 fw-bold">إنشاء حساب مجاني</a>
                    <a href="/account/login?returnUrl=/recommendations/portfolio" class="btn btn-outline-secondary btn-lg px-4">تسجيل الدخول</a>
                </div>
            </div>
        </div>

    </div>
</div>
