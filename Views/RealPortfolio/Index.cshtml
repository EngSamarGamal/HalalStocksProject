@model HalalStocks.ViewModels.RealPortfolioIndexViewModel
@using HalalStocks.ViewModels
@{
    ViewData["Title"] = "المحفظة الفعلية";
    ViewData["NoIndex"] = true;

    // Rendered by two controllers: RealPortfolioController for the user's own page, and
    // Admin/WalletManagementController on behalf of another user. In that second mode the page
    // swaps to the confined management chrome and every URL goes through Model.BasePath.
    if (Model.IsManagementMode)
    {
        Layout = "_WalletManagementLayout";
    }
}

<h3 class="mt-4 mb-3">المحفظة الفعلية</h3>

@if (Model.PageState != RecommendationsPageState.List)
{
    <partial name="~/Views/Recommendations/_AccessGate.cshtml" model="Model.PageState" />
    return;
}

@if (Model.IsManagementMode)
{
    <partial name="~/Views/Admin/WalletManagement/_ManagementNavTabs.cshtml" model="@("portfolio")" />
}
else
{
    <partial name="~/Views/Recommendations/_ManagementRequestBanner.cshtml" />

    <partial name="~/Views/Recommendations/_NavTabs.cshtml" model="@("portfolio")" />
}

@{
    var hasFormErrors = !ViewData.ModelState.IsValid;
    var capitalNotSet = Model.Capital <= 0;
    // Cash the form may spend: capital minus everything invested except the row being edited.
    var editingRow = Model.IsEditing ? Model.Rows.FirstOrDefault(r => r.Id == Model.Form.Id) : null;
    var availableCashForForm = Model.Capital - (Model.InvestedCapital - (editingRow?.TotalPurchase ?? 0));
    var netPnlClass = Model.TotalProfitLoss > 0 ? "text-success" : Model.TotalProfitLoss < 0 ? "text-danger" : "";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-2">رأس المال</h6>
                <form method="post" action="@Model.BasePath/capital" id="capitalForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input name="capital" id="capitalInput" class="form-control" type="number" step="0.01" min="0"
                               value="@Model.Capital.ToString("0.##", inv)" placeholder="أدخل رأس المال" />
                        <button type="submit" class="btn btn-outline-success">حفظ</button>
                    </div>
                    <div class="invalid-feedback" id="capitalFeedback"></div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-2">رأس المال المستثمر</h6>
                <div class="fs-4 fw-bold">@Model.InvestedCapital.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-2">السيولة</h6>
                <div class="fs-4 fw-bold">@Model.AvailableCash.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted mb-2">صافي الربح/الخسارة</h6>
                <div class="fs-4 fw-bold @netPnlClass">@Model.TotalProfitLoss.ToString("N2")</div>
                <div class="fw-semibold @netPnlClass">@Model.NetProfitLossPercent.ToString("N2")%</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="mb-0">@(Model.IsEditing ? "تعديل سهم" : "إضافة سهم إلى محفظتك الفعلية")</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-success" id="togglePortfolioFormBtn" @(capitalNotSet ? "disabled" : "")>أضف إلى محفظتك</button>
                @if (capitalNotSet)
                {
                    <span class="text-muted small">حدد رأس المال أولاً</span>
                }
            </div>
        </div>

        @if (capitalNotSet)
        {
            <div class="alert alert-warning mb-0">يجب تحديد رأس المال أولاً قبل إضافة أسهم إلى محفظتك الفعلية.</div>
        }

        <div id="portfolioFormCard" class="@(Model.IsEditing || hasFormErrors ? "" : "d-none")">
            <form id="portfolioItemForm" method="post" action="@Model.BasePath/items" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Form.Id" />
                <input type="hidden" asp-for="Form.StockId" id="stockIdInput" />

                <div class="row g-3">
                    <div class="col-md-3" data-field="PurchaseDate">
                        <label class="form-label">تاريخ الشراء <span class="text-danger">*</span></label>
                        <input asp-for="Form.PurchaseDate" asp-format="{0:yyyy-MM-dd}" id="purchaseDateInput"
                               class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <div class="invalid-feedback"></div>
                        <span asp-validation-for="Form.PurchaseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3" data-field="StockId">
                        <label class="form-label">اسم السهم <span class="text-danger">*</span></label>
                        <select id="stockSelect" class="form-select">
                            @if (Model.Form.StockId.HasValue)
                            {
                                <option value="@Model.Form.StockId" selected>@Model.Form.SelectedStockNameAr</option>
                            }
                        </select>
                        <div class="invalid-feedback"></div>
                        <span asp-validation-for="Form.StockId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">القطاع</label>
                        <input id="sectorDisplay" class="form-control" readonly value="@Model.Form.SelectedSectorNameAr" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">الموقف</label>
                        <input id="shariahDisplay" class="form-control" readonly value="@Model.Form.SelectedShariahLabel" />
                    </div>

                    <div class="col-md-3" data-field="Quantity">
                        <label class="form-label">عدد الأسهم <span class="text-danger">*</span></label>
                        <input asp-for="Form.Quantity" id="quantityInput" class="form-control" type="number" step="1" min="1" />
                        <div class="invalid-feedback"></div>
                        <span asp-validation-for="Form.Quantity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3" data-field="PurchasePrice">
                        <label class="form-label">سعر الشراء <span class="text-danger">*</span></label>
                        <input asp-for="Form.PurchasePrice" id="purchasePriceInput" class="form-control" type="number" step="0.01" min="0.01" />
                        <div class="invalid-feedback"></div>
                        <span asp-validation-for="Form.PurchasePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">القيمة الشرائية</label>
                        <input id="totalPurchaseDisplay" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">نسبة الشراء</label>
                        <input id="purchaseWeightDisplay" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">سعر السوق</label>
                        <input id="marketPriceDisplay" class="form-control" readonly
                               value="@(Model.Form.SelectedMarketPrice?.ToString("N2"))" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">القيمة السوقية</label>
                        <input id="marketValueDisplay" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">ربح/خسارة</label>
                        <input id="profitLossDisplay" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">ربح/خسارة للسهم</label>
                        <input id="profitLossPerShareDisplay" class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">نسبة الربح/الخسارة</label>
                        <input id="profitLossPercentDisplay" class="form-control" readonly />
                    </div>
                </div>

                <div id="cashWarningAlert" class="alert alert-danger d-none mt-3 mb-0"></div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success" id="portfolioSubmitBtn" @(capitalNotSet ? "disabled" : "")>
                        @(Model.IsEditing ? "تحديث السهم" : "إضافة")
                    </button>
                    @if (Model.IsEditing)
                    {
                        <a href="@Model.BasePath" class="btn btn-outline-secondary">إلغاء</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="mb-3">المحفظة المالية</h5>
        @* Full path, not "_PortfolioTable": short names resolve against the acting controller's
           view folder, which is Views/WalletManagement/ when an admin renders this page. *@
        <partial name="~/Views/RealPortfolio/_PortfolioTable.cshtml" model="Model" />
    </div>
</div>

<div class="modal fade" id="portfolioAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تنبيه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="deleteItemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    هل أنت متأكد من حذف <span class="fw-bold" id="deleteItemName"></span> من محفظتك الفعلية؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.rtl.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .invalid-feedback { display: block; color: #dc3545; font-size: 0.875em; min-height: 0; }
        .form-control.is-invalid, .form-select.is-invalid { border-color: #dc3545; }
        .select2-container--bootstrap-5 .select2-selection { min-height: 38px; }
    </style>

    <script>
        (function () {
            const capital = @Model.Capital.ToString(inv);
            const availableCash = @availableCashForForm.ToString(inv);
            const todayIso = '@DateTime.Today.ToString("yyyy-MM-dd")';
            const serverError = @Html.Raw(TempData["PortfolioError"] != null
                ? System.Text.Json.JsonSerializer.Serialize(TempData["PortfolioError"]!.ToString())
                : "null");

            const form = document.getElementById('portfolioItemForm');
            const formCard = document.getElementById('portfolioFormCard');
            const toggleBtn = document.getElementById('togglePortfolioFormBtn');
            const stockIdInput = document.getElementById('stockIdInput');
            const purchaseDateInput = document.getElementById('purchaseDateInput');
            const quantityInput = document.getElementById('quantityInput');
            const purchasePriceInput = document.getElementById('purchasePriceInput');
            const sectorDisplay = document.getElementById('sectorDisplay');
            const shariahDisplay = document.getElementById('shariahDisplay');
            const marketPriceDisplay = document.getElementById('marketPriceDisplay');
            const totalPurchaseDisplay = document.getElementById('totalPurchaseDisplay');
            const purchaseWeightDisplay = document.getElementById('purchaseWeightDisplay');
            const marketValueDisplay = document.getElementById('marketValueDisplay');
            const profitLossDisplay = document.getElementById('profitLossDisplay');
            const profitLossPerShareDisplay = document.getElementById('profitLossPerShareDisplay');
            const profitLossPercentDisplay = document.getElementById('profitLossPercentDisplay');
            const cashWarningAlert = document.getElementById('cashWarningAlert');

            let marketPrice = @(Model.Form.SelectedMarketPrice?.ToString(inv) ?? "null");

            function showModal(message) {
                const modalEl = document.getElementById('portfolioAlertModal');
                if (!modalEl || typeof bootstrap === 'undefined') return;
                modalEl.querySelector('.modal-body').textContent = message;
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }

            function setFieldState(fieldName, message) {
                const wrapper = document.querySelector('[data-field="' + fieldName + '"]');
                if (!wrapper) return;
                const control = wrapper.querySelector('.form-control, .form-select');
                const feedback = wrapper.querySelector('.invalid-feedback');
                // Select2 replaces the <select>; mark its rendered container instead.
                const select2 = wrapper.querySelector('.select2-selection');
                if (message) {
                    if (control) control.classList.add('is-invalid');
                    if (select2) select2.classList.add('is-invalid');
                    if (feedback) feedback.textContent = message;
                } else {
                    if (control) control.classList.remove('is-invalid');
                    if (select2) select2.classList.remove('is-invalid');
                    if (feedback) feedback.textContent = '';
                }
            }

            function applyPnlClass(el, value) {
                el.classList.remove('text-success', 'text-danger');
                if (value > 0) el.classList.add('text-success');
                else if (value < 0) el.classList.add('text-danger');
            }

            function updateCalculations() {
                const quantity = parseFloat(quantityInput.value) || 0;
                const purchasePrice = parseFloat(purchasePriceInput.value) || 0;
                const totalPurchase = quantity * purchasePrice;
                const purchaseWeight = capital === 0 ? 0 : (totalPurchase / capital) * 100;

                totalPurchaseDisplay.value = totalPurchase.toFixed(2);
                purchaseWeightDisplay.value = purchaseWeight.toFixed(2) + '%';

                if (marketPrice === null) {
                    marketValueDisplay.value = '';
                    profitLossDisplay.value = '';
                    profitLossPerShareDisplay.value = '';
                    profitLossPercentDisplay.value = '';
                    [profitLossDisplay, profitLossPerShareDisplay, profitLossPercentDisplay]
                        .forEach(function (el) { applyPnlClass(el, 0); });
                    return;
                }

                const marketValue = quantity * marketPrice;
                const profitLoss = marketValue - totalPurchase;
                const profitLossPerShare = marketPrice - purchasePrice;
                const profitLossPercent = totalPurchase === 0 ? 0 : (profitLoss / totalPurchase) * 100;

                marketValueDisplay.value = marketValue.toFixed(2);
                profitLossDisplay.value = profitLoss.toFixed(2);
                profitLossPerShareDisplay.value = profitLossPerShare.toFixed(2);
                profitLossPercentDisplay.value = profitLossPercent.toFixed(2) + '%';

                applyPnlClass(profitLossDisplay, profitLoss);
                applyPnlClass(profitLossPerShareDisplay, profitLossPerShare);
                applyPnlClass(profitLossPercentDisplay, profitLossPercent);
            }

            function validateForm() {
                let ok = true;

                if (!purchaseDateInput.value) {
                    setFieldState('PurchaseDate', 'يرجى اختيار تاريخ الشراء');
                    ok = false;
                } else if (purchaseDateInput.value > todayIso) {
                    setFieldState('PurchaseDate', 'لا يمكن أن يكون تاريخ الشراء في المستقبل');
                    ok = false;
                } else {
                    setFieldState('PurchaseDate', '');
                }

                if (!stockIdInput.value) {
                    setFieldState('StockId', 'يرجى اختيار السهم');
                    ok = false;
                } else {
                    setFieldState('StockId', '');
                }

                const quantity = parseFloat(quantityInput.value) || 0;
                if (!quantityInput.value) {
                    setFieldState('Quantity', 'يرجى إدخال عدد الأسهم');
                    ok = false;
                } else if (quantity < 1 || !Number.isInteger(quantity)) {
                    setFieldState('Quantity', 'عدد الأسهم يجب أن يكون رقماً صحيحاً لا يقل عن 1');
                    ok = false;
                } else {
                    setFieldState('Quantity', '');
                }

                const purchasePrice = parseFloat(purchasePriceInput.value) || 0;
                if (!purchasePriceInput.value) {
                    setFieldState('PurchasePrice', 'يرجى إدخال سعر الشراء');
                    ok = false;
                } else if (purchasePrice <= 0) {
                    setFieldState('PurchasePrice', 'سعر الشراء يجب أن يكون أكبر من صفر');
                    ok = false;
                } else {
                    setFieldState('PurchasePrice', '');
                }

                const totalPurchase = quantity * purchasePrice;
                if (totalPurchase > 0 && totalPurchase > availableCash) {
                    cashWarningAlert.textContent =
                        'القيمة الشرائية (' + totalPurchase.toFixed(2) + ') تتجاوز السيولة المتاحة (' + availableCash.toFixed(2) + ').';
                    cashWarningAlert.classList.remove('d-none');
                    ok = false;
                } else {
                    cashWarningAlert.classList.add('d-none');
                }

                return ok;
            }

            function refresh() {
                updateCalculations();
                validateForm();
            }

            [purchaseDateInput, quantityInput, purchasePriceInput].forEach(function (el) {
                el.addEventListener('input', refresh);
                el.addEventListener('change', refresh);
            });

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () { formCard.classList.toggle('d-none'); });
            }

            form.addEventListener('submit', function (event) {
                if (!validateForm()) {
                    event.preventDefault();
                    const quantity = parseFloat(quantityInput.value) || 0;
                    const purchasePrice = parseFloat(purchasePriceInput.value) || 0;
                    if (quantity * purchasePrice > availableCash) {
                        showModal('لا يمكن إضافة هذا السهم لأن قيمته الشرائية تتجاوز السيولة المتاحة في محفظتك ('
                            + availableCash.toFixed(2) + ').');
                    }
                }
            });

            // ── Capital form ──────────────────────────────────────────────────
            const capitalForm = document.getElementById('capitalForm');
            const capitalInput = document.getElementById('capitalInput');
            const investedCapital = @Model.InvestedCapital.ToString(inv);

            capitalForm.addEventListener('submit', function (event) {
                const entered = parseFloat(capitalInput.value);
                if (isNaN(entered) || entered < 0) {
                    event.preventDefault();
                    capitalInput.classList.add('is-invalid');
                    document.getElementById('capitalFeedback').textContent = 'يرجى إدخال قيمة صالحة لرأس المال';
                    showModal('يرجى إدخال قيمة صالحة لرأس المال.');
                    return;
                }
                if (entered < investedCapital) {
                    event.preventDefault();
                    capitalInput.classList.add('is-invalid');
                    document.getElementById('capitalFeedback').textContent =
                        'رأس المال لا يمكن أن يقل عن إجمالي القيمة الشرائية (' + investedCapital.toFixed(2) + ')';
                    showModal('لا يمكن تخفيض رأس المال أقل من إجمالي القيمة الشرائية الحالية ('
                        + investedCapital.toFixed(2) + ').');
                    return;
                }
                capitalInput.classList.remove('is-invalid');
                document.getElementById('capitalFeedback').textContent = '';
            });

            // ── Delete confirmation ───────────────────────────────────────────
            const deleteModalEl = document.getElementById('deleteItemModal');
            const deleteForm = document.getElementById('deleteItemForm');
            document.querySelectorAll('[data-delete-item-id]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    deleteForm.action = '@Model.BasePath/items/' + btn.dataset.deleteItemId + '/delete';
                    document.getElementById('deleteItemName').textContent = btn.dataset.deleteItemName || '';
                    bootstrap.Modal.getOrCreateInstance(deleteModalEl).show();
                });
            });

            // ── Stock picker (Select2 + instant server-side search) ───────────
            function loadQuote(stockId) {
                sectorDisplay.value = '';
                shariahDisplay.value = '';
                marketPriceDisplay.value = 'جاري التحميل...';
                marketPrice = null;
                updateCalculations();

                fetch('/api/stocks/' + stockId + '/quote')
                    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                    .then(function (data) {
                        sectorDisplay.value = data.sectorNameAr || '';
                        shariahDisplay.value = data.shariahLabel || '';
                        marketPrice = (data.marketPrice === null || data.marketPrice === undefined)
                            ? null
                            : parseFloat(data.marketPrice);
                        marketPriceDisplay.value = marketPrice === null ? 'غير متاح' : marketPrice.toFixed(2);
                        refresh();
                    })
                    .catch(function () {
                        marketPriceDisplay.value = 'غير متاح';
                        marketPrice = null;
                        refresh();
                    });
            }

            $(function () {
                $('#stockSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: 'ابحث بالكود أو باسم السهم',
                    allowClear: true,
                    minimumInputLength: 1,
                    dir: 'rtl',
                    language: {
                        inputTooShort: function () { return 'اكتب حرفاً واحداً على الأقل'; },
                        noResults: function () { return 'لا توجد نتائج'; },
                        searching: function () { return 'جاري البحث...'; }
                    },
                    ajax: {
                        url: '/api/stocks/search',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) {
                            return {
                                results: data.map(function (s) {
                                    return { id: s.id, text: s.nameAr, ticker: s.ticker };
                                })
                            };
                        },
                        cache: true
                    },
                    templateResult: function (item) {
                        if (!item.id) return item.text;
                        return item.ticker ? item.ticker + ' — ' + item.text : item.text;
                    },
                    templateSelection: function (item) { return item.text; }
                });

                $('#stockSelect').on('select2:select', function (e) {
                    stockIdInput.value = e.params.data.id;
                    loadQuote(e.params.data.id);
                });

                $('#stockSelect').on('select2:clear', function () {
                    stockIdInput.value = '';
                    sectorDisplay.value = '';
                    shariahDisplay.value = '';
                    marketPriceDisplay.value = '';
                    marketPrice = null;
                    refresh();
                });

                refresh();
                if (serverError) showModal(serverError);
            });
        })();
    </script>
}
